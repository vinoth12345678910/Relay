# Relay configuration. Copy to .env and fill in the two required secrets.
# Spring Boot maps RELAY_FOO_BAR to relay.foo-bar, so every setting in RelayProperties can be set here.

# --- Required ---
RELAY_ADMIN_TOKEN=change-me-admin-token
# base64 of any secret; run: openssl rand -base64 32
RELAY_SECRET_ENCRYPTION_KEY=change-me-base64-key

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=relay
DB_USER=relay
DB_PASSWORD=relay
SERVER_PORT=8080
# dev is the default profile; use prod in production
SPRING_PROFILES_ACTIVE=dev

# --- Delivery worker ---
RELAY_WORKER_ENABLED=true
RELAY_WORKER_POOL_SIZE=5
RELAY_BATCH_SIZE=10
RELAY_POLL_INTERVAL_MS=1000
# graceful stop waits this long for in-flight sends
RELAY_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
# max simultaneous sends to one endpoint per instance (must not exceed RELAY_WORKER_POOL_SIZE)
RELAY_PER_ENDPOINT_MAX_CONCURRENCY=4

# --- Leases and HTTP (lease must exceed total timeout in seconds + 5) ---
RELAY_LEASE_SECONDS=30
RELAY_HTTP_CONNECT_TIMEOUT_MS=3000
RELAY_HTTP_TOTAL_TIMEOUT_MS=5000

# --- Retries and resilience ---
# seconds between attempts; attempts = steps + 1
RELAY_RETRY_SCHEDULE=10,30,120,600,1800,7200,21600,43200
# cap on a receiver's Retry-After (429/503)
RELAY_RETRY_AFTER_MAX_SECONDS=3600
# consecutive failures before an endpoint is paused
RELAY_BREAKER_THRESHOLD=20

# --- Retention (setting exists; the cleanup job is not implemented yet) ---
RELAY_RETENTION_DAYS=30

# --- Outbound safety ---
# Lets endpoints target private networks (needed when receivers are other containers).
# Loopback, link-local (169.254.169.254) and multicast stay blocked. NEVER enable in production.
RELAY_SSRF_ALLOW_PRIVATE_NETWORKS=false
