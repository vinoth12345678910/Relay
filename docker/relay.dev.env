# DEMO VALUES ONLY. Fake secrets, never reuse them anywhere real.
SPRING_PROFILES_ACTIVE=dev
RELAY_ADMIN_TOKEN=dev-admin-token
# base64, same format as .env.example (any base64 string; the app hashes it down to an AES-256 key)
RELAY_SECRET_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktZm9yLWxvY2FsISE=

# The mock receiver is another container on a private network, so allow private ranges.
# Metadata (169.254.169.254) and loopback are still blocked; the chaos demo checks that.
RELAY_SSRF_ALLOW_PRIVATE_NETWORKS=true

# Short timings so the chaos demo takes seconds, not hours
RELAY_RETRY_SCHEDULE=2,3,5,5,5,5,5,5
RELAY_LEASE_SECONDS=15
RELAY_BREAKER_THRESHOLD=5
RELAY_WORKER_POOL_SIZE=8

# The dev profile logs every SQL statement at DEBUG; far too noisy and slow for a load demo
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_RELAY=INFO
LOGGING_LEVEL_ORG_HIBERNATE=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
SPRING_JPA_SHOW_SQL=false
